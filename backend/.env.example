# Conexão com o banco de dados PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.xxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Servidor e Ambiente
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
CRON_TIMEZONE=America/Sao_Paulo

# Autenticação JWT
JWT_SECRET=sua_chave_secreta_jwt_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=8h

# Administrador inicial local
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@viagenda.com
ADMIN_PASSWORD_HASH=

# Envio de E-mails Transacionais (Nodemailer)
# Para gerar a senha de app do Google: Conta Google > Segurança > Verificação em 2 etapas > Senhas de app
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app-de-16-letras
EMAIL_FROM=ViAgenda <noreply@viagenda.com>
